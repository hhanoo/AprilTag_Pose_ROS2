<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apriltag_pose_estimator_py</name>
  <version>0.0.0</version>
  <description>AprilTag-based multi-target pose estimator</description>

  <maintainer email="woo980711@gmail.com">hhanoo</maintainer>
  
  <license>MIT</license>

  <!-- ========================================================= -->
  <!-- Core ROS2 dependencies -->
  <!-- ========================================================= -->
  <!-- * ROS 2 Python client library -->
  <depend>rclpy</depend>
  
  <!-- * Pose and geometry message types -->
  <depend>geometry_msgs</depend>
  
  <!-- * Image and camera info message types -->
  <depend>sensor_msgs</depend>
  
  <!-- * Visualization markers for RViz -->
  <depend>visualization_msgs</depend>
  
  <!-- * OpenCV-ROS2 image conversion bridge -->
  <depend>cv_bridge</depend>

  <!-- ========================================================= -->
  <!-- Test dependencies -->
  <!-- ========================================================= -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ========================================================= -->
  <!-- Export build type -->
  <!-- ========================================================= -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
