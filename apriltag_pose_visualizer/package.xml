<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apriltag_pose_visualizer</name>
  <version>3.3.0</version>
  <description>AprilTag pose visualizer</description>
  <maintainer email="woo980711@gmail.com">hhanoo</maintainer>
  <license>MIT</license>

  <!-- ========================================================= -->
  <!-- Build tool dependencies -->
  <!-- ========================================================= -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ========================================================= -->
  <!-- Core ROS2 dependencies -->
  <!-- ========================================================= -->
  <!-- * ROS 2 Python client library -->
  <depend>rclpy</depend>
  
  <!-- * Image and camera info message types -->
  <depend>sensor_msgs</depend>
  
  <!-- * Standard service definitions (Trigger) -->
  <depend>std_srvs</depend>
  
  <!-- * OpenCV-ROS2 image conversion bridge -->
  <depend>cv_bridge</depend>

  <!-- * AprilTag pose estimator messages -->
  <depend>apriltag_pose_estimator_msgs</depend>

  <!-- ========================================================= -->
  <!-- Test dependencies -->
  <!-- ========================================================= -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- ========================================================= -->
  <!-- Export build type -->
  <!-- ========================================================= -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
