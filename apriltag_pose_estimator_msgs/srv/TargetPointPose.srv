# Service to get target points pose from latest detection

# Request
builtin_interfaces/Time request_time    # Client-side reference time
string group_name                       # Group to query ("" = first group in group_names)
---
# Response
bool success                            # Whether poses are available
string message                          # Status message
builtin_interfaces/Time data_time       # Timestamp of returned poses
geometry_msgs/PoseArray poses           # Target points pose in camera frame